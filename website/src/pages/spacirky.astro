---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PLAY_STORE_URL, SITE_TITLE } from '../consts';

// Each špacírka lives in its own blog post, which doubles as the game's landing
// page. This overview reads them straight from the collection so the route data
// is never duplicated.
const hry = (await getCollection('blog'))
	.filter((post) => post.data.spacirka)
	.sort((a, b) => a.data.spacirka!.poradie - b.data.spacirka!.poradie)
	.map((post) => ({
		...post.data.spacirka!,
		popis: post.data.description,
		image: post.data.heroImage,
		url: `/blog/${post.id}/`,
	}));

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Geolokačné hry Špacírkovníka v Bratislave',
	itemListElement: hry.map((hra, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: hra.nazov,
		url: new URL(hra.url, Astro.site).href,
	})),
};
---

<!doctype html>
<html lang="sk">
	<head>
		<BaseHead
			title={`Geolokačné hry a trasy v Bratislave | ${SITE_TITLE}`}
			description="Prehľad všetkých geolokačných hier Špacírkovníka – trasy pre rodiny s deťmi v Bratislave a Petržalke, s dĺžkou, časom aj miestom štartu."
			jsonLd={jsonLd}
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-hero">
				<h1>🗺️ Geolokačné hry a trasy v Bratislave</h1>
				<p>Každá špacírka je skutočná trasa na skutočnom mieste – s príbehom, hádankami a zážitkami pre celú rodinu. Ideálny tip, kam s deťmi v Bratislave a Petržalke.</p>
			</div>

			<div class="games-list">
				{hry.map((hra) => (
					<a class="game-item" href={hra.url}>
						<img src={hra.image} alt={hra.nazov} class="game-image" loading="lazy" />
						<div class="game-content">
							<div class="game-header">
								<div>
									<h2>{hra.nazov}</h2>
									<div class="game-meta">
										<span>📍 {hra.region}</span>
										<span>🚶 {hra.dlzka}</span>
										<span>⏱️ {hra.cas}</span>
									</div>
								</div>
								<div class={`price-tag ${hra.nedostupna ? 'unavailable' : hra.paid ? 'paid' : 'available'}`}>
									{hra.nedostupna ? 'Nedostupná' : hra.paid ? 'K zakúpeniu' : 'Zadarmo'}
								</div>
							</div>
							<p class="game-desc">{hra.popis}</p>
							<p class="game-start">🏁 Štart: <strong>{hra.start}</strong></p>
						</div>
					</a>
				))}
			</div>

			<div class="download-cta">
				<p>Všetky špacírky sú dostupné v bezplatnej appke Špacírkovník.</p>
				<a class="btn-primary" href={PLAY_STORE_URL} target="_blank" rel="noopener">
					▶ Stiahnuť na Google Play
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-hero {
		text-align: center;
		padding: 2rem 0 3rem;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 3rem;
	}
	.page-hero h1 { margin-bottom: 0.75rem; }
	.page-hero p {
		color: rgb(var(--gray));
		font-size: 1.1rem;
		max-width: 600px;
		margin: 0 auto;
	}

	.games-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-bottom: 4rem;
	}

	.game-item {
		display: flex;
		gap: 1.5rem;
		background: #FAF6F1;
		border-radius: 16px;
		overflow: hidden;
		border: 2px solid transparent;
		transition: border-color 0.2s;
		text-decoration: none;
		color: inherit;
	}
	.game-item:hover { border-color: #7A4F2E; }

	.game-image {
		width: 160px;
		height: 160px;
		object-fit: cover;
		border-radius: 12px;
		align-self: center;
		flex-shrink: 0;
		margin-left: 1rem;
	}

	.game-content {
		padding: 1.5rem 1.5rem 1.5rem 0;
		flex: 1;
	}

	.game-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}
	.game-header h2 {
		font-size: 1.15rem;
		color: #3D2314;
		margin-bottom: 0.4rem;
	}
	.game-meta {
		display: flex;
		gap: 1rem;
		font-size: 0.82rem;
		color: #8B6043;
		flex-wrap: wrap;
	}

	.price-tag {
		white-space: nowrap;
		background: #7A4F2E;
		color: #fff;
		padding: 0.35rem 0.9rem;
		border-radius: 50px;
		font-weight: 700;
		font-size: 0.9rem;
		flex-shrink: 0;
	}
	.price-tag.available { background: #52A47A; }
	.price-tag.paid { background: #C9761B; }
	.price-tag.unavailable { background: #8E8A86; }

	.game-desc {
		color: #6B4C35;
		font-size: 0.95rem;
		margin: 0 0 0.5rem;
		line-height: 1.6;
	}
	.game-start {
		font-size: 0.85rem;
		color: #8B6043;
		margin: 0;
	}

	.download-cta {
		text-align: center;
		padding: 3rem 0;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.download-cta p {
		color: rgb(var(--gray));
		margin-bottom: 1.5rem;
	}

	.btn-primary {
		display: inline-block;
		background: #7A4F2E;
		color: #fff;
		text-decoration: none;
		padding: 0.85rem 1.75rem;
		border-radius: 50px;
		font-weight: 600;
		font-size: 1rem;
		transition: background 0.2s, transform 0.15s;
		box-shadow: 0 4px 16px rgba(122,79,46,0.3);
	}
	.btn-primary:hover {
		background: #3D2314;
		transform: translateY(-2px);
		color: #fff;
	}

	@media (max-width: 600px) {
		.game-item { flex-direction: column; }
		.game-image { width: 100%; height: 180px; margin-left: 0; }
		.game-content { padding: 1.25rem; }
	}
</style>
