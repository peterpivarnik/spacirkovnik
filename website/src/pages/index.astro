---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { PLAY_STORE_URL, SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = await getCollection('blog');

const latestPosts = [...allPosts]
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const topSpacirky = allPosts
	.filter((post) => post.data.spacirka)
	.sort((a, b) => a.data.spacirka!.poradie - b.data.spacirka!.poradie)
	.slice(0, 3);

const faq = [
	{
		otazka: 'Čo je geolokačná hra?',
		odpoved:
			'Geolokačná hra je hra, ktorá sa hrá vonku v skutočnom priestore. Appka sleduje tvoju polohu a vedie ťa po trase – keď dôjdeš na zastávku, odomkne sa ďalší kúsok príbehu a hádanka. V Špacírkovníku je každá trasa skutočná prechádzka v Bratislave.',
	},
	{
		otazka: 'Kam s deťmi v Bratislave, keď neviem, čo vymyslieť?',
		odpoved:
			'Špacírkovník ponúka geolokačné hry v Petržalke – v Sade Janka Kráľa, pri jazere Draždiak, v Pečnianskom lese, popri Chorvátskom ramene a na Závodisku. Vyberieš si trasu podľa dĺžky a času a vyrazíš.',
	},
	{
		otazka: 'Ako dlho trvá jedna špacírka?',
		odpoved:
			'Od 30 minút po 3 hodiny, podľa toho, ktorú si vyberieš. Trasy majú od 1 do 6 kilometrov a pri každej nájdeš presnú dĺžku aj odhadovaný čas.',
	},
	{
		otazka: 'Koľko to stojí?',
		odpoved:
			'Appka je zadarmo a jedna špacírka je vždy bezplatná – môžeš si to teda vyskúšať bez záväzkov. Ostatné špacírky si odomkneš priamo v appke.',
	},
	{
		otazka: 'Pre koho sú špacírky vhodné?',
		odpoved:
			'Pre celé rodiny s deťmi. Príbehy sú rozprávkové, hádanky sa točia okolo prírody a histórie daného miesta a trasy vedú po pohodlných chodníkoch.',
	},
];

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'MobileApplication',
		name: SITE_TITLE,
		description: SITE_DESCRIPTION,
		applicationCategory: 'GameApplication',
		operatingSystem: 'Android',
		url: 'https://spacirkovnik.sk/',
		installUrl: PLAY_STORE_URL,
		inLanguage: 'sk',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
		areaServed: { '@type': 'City', name: 'Bratislava', addressCountry: 'SK' },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map((item) => ({
			'@type': 'Question',
			name: item.otazka,
			acceptedAnswer: { '@type': 'Answer', text: item.odpoved },
		})),
	},
];
---

<!doctype html>
<html lang="sk">
	<head>
		<BaseHead
			title="Geolokačné hry pre deti a rodiny v Bratislave | Špacírkovník"
			description={SITE_DESCRIPTION}
			jsonLd={jsonLd}
		/>
	</head>
	<body>
		<Header />

		<!-- HERO -->
		<section class="hero">
			<img src="https://firebasestorage.googleapis.com/v0/b/spacirkovnik-app.firebasestorage.app/o/banner.png?alt=media" alt="Špacírkovník – Sleduj mapu, rieš hádanky, objavuj mesto!" class="hero-banner" />
			<h1>Špacírkovník – geolokačné hry pre rodiny v Bratislave</h1>
			<p class="hero-sub">Mení rodinnú prechádzku na malé dobrodružstvo. Sleduj mapu, lúšti hádanky, objavuj mesto!</p>
			<div class="hero-ctas">
				<a class="btn-primary" href={PLAY_STORE_URL} target="_blank" rel="noopener">
					▶ Stiahnuť na Google Play
				</a>
			</div>
		</section>

		<!-- AKO TO FUNGUJE -->
		<section class="how">
			<h2>Ako funguje geolokačná hra?</h2>
			<p class="section-lead">
				Špacírkovník je mestská hra, ktorá sa hrá vonku. Appka pozná tvoju polohu a vedie ťa po skutočnej
				trase – zatiaľ po Bratislave a Petržalke. Keď hľadáš, kam s deťmi cez víkend, stačí si vybrať trasu
				a vyraziť.
			</p>
			<div class="steps">
				<div class="step">
					<div class="step-icon">📱</div>
					<h3>Stiahni appku</h3>
					<p>Zadarmo na Google Play. Jedna špacírka je vždy zdarma – skús to bez záväzkov.</p>
				</div>
				<div class="step">
					<div class="step-icon">🗺️</div>
					<h3>Vyraz na trasu</h3>
					<p>Appka ťa zavedie po skutočnej trase plnej krásnej prírody a zaujímavých miest.</p>
				</div>
				<div class="step">
					<div class="step-icon">🧩</div>
					<h3>Lúšti hádanky</h3>
					<p>Na zastávkach plníš úlohy, odhaľuješ príbeh a spoznávaš okolie novým spôsobom.</p>
				</div>
			</div>
		</section>

		<!-- SCREENSHOTY -->
		<section class="screenshots">
			<h2>Pozri, ako vyzerá špacírka</h2>
			<div class="screenshot-grid">
				<img src="https://firebasestorage.googleapis.com/v0/b/spacirkovnik-app.firebasestorage.app/o/screenshots%2F01_zoznam_hier.png?alt=media" alt="Zoznam špacírok" />
				<img src="https://firebasestorage.googleapis.com/v0/b/spacirkovnik-app.firebasestorage.app/o/screenshots%2F03_uvod_hry.png?alt=media" alt="Úvod špacírky" />
				<img src="https://firebasestorage.googleapis.com/v0/b/spacirkovnik-app.firebasestorage.app/o/screenshots%2F05_kvizova_otazka.png?alt=media" alt="Kvízová otázka" />
				<img src="https://firebasestorage.googleapis.com/v0/b/spacirkovnik-app.firebasestorage.app/o/screenshots%2F04_navigacia.png?alt=media" alt="Navigácia po trase" />
			</div>
		</section>

		<!-- DOSTUPNÉ ŠPACÍRKY PREVIEW -->
		<section class="games-preview">
			<h2>Dostupné špacírky v Bratislave</h2>
			<p class="games-sub">Každá špacírka je jedinečný príbeh na skutočnom mieste – v parku, v lese alebo pri vode.</p>
			<div class="games-grid">
				{topSpacirky.map((post) => (
					<a class="game-card" href={`/blog/${post.id}/`}>
						<h3>{post.data.spacirka!.nazov}</h3>
						<p>{post.data.description}</p>
						<p class="game-card-meta">📍 {post.data.spacirka!.region} · 🚶 {post.data.spacirka!.dlzka} · ⏱️ {post.data.spacirka!.cas}</p>
					</a>
				))}
			</div>
			<a class="btn-secondary" href="/spacirky">Všetky špacírky →</a>
		</section>

		<!-- BLOG -->
		<section class="blog-preview">
			<h2>Blog</h2>
			<p class="games-sub">Novinky, nové špacírky a tipy na výlety.</p>
			<div class="blog-grid">
				{latestPosts.map((post) => (
					<a class="blog-card" href={`/blog/${post.id}/`}>
						{post.data.heroImage && (
							<div class="blog-card-img"><img src={post.data.heroImage} alt="" loading="lazy" /></div>
						)}
						<div class="blog-card-body">
							<p class="blog-card-date"><FormattedDate date={post.data.pubDate} /></p>
							<h3 class="blog-card-title">{post.data.title}</h3>
						</div>
					</a>
				))}
			</div>
			<a class="btn-secondary" href="/blog">Prejsť na blog →</a>
		</section>

		<!-- FAQ -->
		<section class="faq">
			<h2>Časté otázky</h2>
			<div class="faq-list">
				{faq.map((item) => (
					<details class="faq-item">
						<summary>{item.otazka}</summary>
						<p>{item.odpoved}</p>
					</details>
				))}
			</div>
		</section>

		<!-- ZÁVEREČNÁ CTA -->
		<section class="cta-final">
			<img src="https://firebasestorage.googleapis.com/v0/b/spacirkovnik-app.firebasestorage.app/o/logoNoBackground.png?alt=media" alt="Špacírkovník logo" class="cta-logo" />
			<h2>Vyraz na dobrodružstvo</h2>
			<p>Stačí appka, pohodlná obuv a chuť objavovať.</p>
			<a class="btn-primary" href={PLAY_STORE_URL} target="_blank" rel="noopener">
				▶ Stiahnuť zadarmo
			</a>
		</section>

		<Footer />
	</body>
</html>

<style>
	/* HERO */
	.hero {
		text-align: center;
		padding: 3rem 1rem 2rem;
		background: linear-gradient(180deg, #F0E9DF 0%, #fff 100%);
	}
	.hero-banner {
		max-width: 600px;
		width: 100%;
		border-radius: 16px;
		box-shadow: 0 8px 32px rgba(61,35,20,0.12);
		margin-bottom: 1.5rem;
	}
	.hero h1 {
		font-size: 1.6rem;
		color: #3D2314;
		margin-bottom: 0.75rem;
	}
	.hero-sub {
		font-size: 1.15rem;
		color: #6B4C35;
		margin-bottom: 2rem;
	}
	.section-lead {
		max-width: 700px;
		margin: -1.5rem auto 2.5rem;
		color: #6B4C35;
		font-size: 1rem;
	}
	.hero-ctas {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* BUTTONS */
	.btn-primary {
		display: inline-block;
		background: #7A4F2E;
		color: #fff;
		text-decoration: none;
		padding: 0.85rem 1.75rem;
		border-radius: 50px;
		font-weight: 600;
		font-size: 1rem;
		transition: background 0.2s, transform 0.15s;
		box-shadow: 0 4px 16px rgba(122,79,46,0.3);
	}
	.btn-primary:hover {
		background: #3D2314;
		transform: translateY(-2px);
		color: #fff;
	}
	.btn-secondary {
		display: inline-block;
		background: transparent;
		color: #7A4F2E;
		text-decoration: none;
		padding: 0.85rem 1.75rem;
		border-radius: 50px;
		font-weight: 600;
		font-size: 1rem;
		border: 2px solid #7A4F2E;
		transition: all 0.2s;
	}
	.btn-secondary:hover {
		background: #7A4F2E;
		color: #fff;
	}

	/* HOW IT WORKS */
	.how {
		padding: 4rem 1rem;
		text-align: center;
		background: linear-gradient(180deg, #F0E9DF 0%, #ffffff 100%);
	}
	.how h2 {
		margin-bottom: 2.5rem;
		color: #3D2314;
	}
	.steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 2rem;
		max-width: 860px;
		margin: 0 auto;
	}
	.step {
		padding: 2rem 1.5rem;
		background: #FAF6F1;
		border-radius: 16px;
	}
	.step-icon {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}
	.step h3 {
		font-size: 1.1rem;
		color: #3D2314;
		margin-bottom: 0.5rem;
	}
	.step p {
		font-size: 0.95rem;
		color: #6B4C35;
		margin: 0;
	}

	/* SCREENSHOTS */
	.screenshots {
		padding: 4rem 1rem;
		text-align: center;
		background: linear-gradient(180deg, #F0E9DF 0%, #ffffff 100%);
	}
	.screenshots h2 {
		margin-bottom: 2rem;
		color: #3D2314;
	}
	.screenshot-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: 1rem;
		max-width: 860px;
		margin: 0 auto;
	}
	.screenshot-grid img {
		width: 100%;
		border-radius: 12px;
		box-shadow: 0 4px 16px rgba(61,35,20,0.12);
	}

	/* GAMES */
	.games-preview {
		padding: 4rem 1rem;
		text-align: center;
		background: linear-gradient(180deg, #F0E9DF 0%, #ffffff 100%);
	}
	.games-preview h2 {
		margin-bottom: 0.5rem;
		color: #3D2314;
	}
	.games-sub {
		color: #6B4C35;
		margin-bottom: 2.5rem;
	}
	.blog-preview {
		padding: 4rem 1rem;
		text-align: center;
		background: linear-gradient(180deg, #F0E9DF 0%, #ffffff 100%);
	}
	.blog-preview h2 {
		margin-bottom: 0.5rem;
		color: #3D2314;
	}
	.blog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		max-width: 960px;
		margin: 0 auto 2rem;
		text-align: left;
	}
	.blog-card {
		background: #FAF6F1;
		border-radius: 16px;
		overflow: hidden;
		border: 2px solid transparent;
		transition: border-color 0.2s;
		text-decoration: none;
		display: flex;
		flex-direction: column;
	}
	.blog-card:hover { border-color: #7A4F2E; }
	.blog-card-img {
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}
	.blog-card-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.blog-card-body { padding: 1.25rem; }
	.blog-card-date {
		font-size: 0.8rem;
		color: #8B6043;
		margin: 0 0 0.4rem;
	}
	.blog-card-title {
		font-size: 1rem;
		color: #3D2314;
		margin: 0;
		line-height: 1.35;
	}
	.games-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		max-width: 960px;
		margin: 0 auto 2rem;
		text-align: left;
	}
	.game-card {
		background: #FAF6F1;
		border-radius: 16px;
		padding: 1.5rem;
		border: 2px solid transparent;
		transition: border-color 0.2s;
		position: relative;
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.game-card:hover {
		border-color: #7A4F2E;
	}
	.game-card h3 {
		font-size: 1rem;
		color: #3D2314;
		margin: 0 0 0.5rem;
	}
	.game-card p {
		font-size: 0.9rem;
		color: #6B4C35;
		margin: 0;
	}
	.game-card-meta {
		margin-top: 0.75rem !important;
		font-size: 0.8rem !important;
		color: #8B6043 !important;
	}

	/* FAQ */
	.faq {
		padding: 4rem 1rem;
		background: linear-gradient(180deg, #F0E9DF 0%, #ffffff 100%);
	}
	.faq h2 {
		text-align: center;
		margin-bottom: 2.5rem;
		color: #3D2314;
	}
	.faq-list {
		max-width: 720px;
		margin: 0 auto;
	}
	.faq-item {
		background: #FAF6F1;
		border-radius: 12px;
		padding: 1rem 1.25rem;
		margin-bottom: 0.75rem;
	}
	.faq-item summary {
		cursor: pointer;
		font-weight: 700;
		color: #3D2314;
		font-size: 1rem;
	}
	.faq-item p {
		margin: 0.75rem 0 0;
		color: #6B4C35;
		font-size: 0.95rem;
		line-height: 1.6;
	}

	/* FINAL CTA */
	.cta-final {
		padding: 5rem 1rem;
		text-align: center;
		background: linear-gradient(180deg, #E8D9C8 0%, #F6EFE6 100%);
	}
	.cta-logo {
		width: 120px;
		height: 120px;
		object-fit: contain;
		margin-bottom: 1.5rem;
	}
	.cta-final h2 {
		color: #3D2314;
		margin-bottom: 0.75rem;
	}
	.cta-final p {
		color: #6B4C35;
		margin-bottom: 2rem;
	}
</style>
